# GEMINI_API_KEY: Required for Gemini AI API calls (/api/ai-analyze).
# Can be generated from any Google account in Google AI Studio (https://aistudio.google.com/apikey).
# Configure in AI Studio Secrets or Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
