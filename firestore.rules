rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptionalNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    // Trusted RBAC helpers (used only in get/create/update/delete, never in list)
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasAccount() {
      return isSignedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }

    function accountData() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }

    function isActiveAccount() {
      return hasAccount() && accountData().active == true;
    }

    function isValidAuthorizedUids(data) {
      return data.authorizedUids is list
        && data.authorizedUids.size() >= 1
        && data.authorizedUids.size() <= 50
        && data.authorizedUids[0] is string
        && data.adminUid in data.authorizedUids;
    }

    // Validation Blueprint: AppBootstrap
    function isValidBootstrap(data) {
      return data.keys().hasAll(['id', 'initialized', 'adminUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'initialized', 'adminUid', 'createdAt', 'updatedAt'])
        && data.id == 'bootstrap'
        && data.initialized == true
        && isValidId(data.adminUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AdminMarker
    function isValidAdminMarker(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: AppAccount
    function isValidAppAccount(data, userId) {
      return data.keys().hasAll([
          'uid', 'username', 'email', 'displayName', 'role', 'adminUid', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'email', 'displayName', 'role', 'adminUid', 'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 160
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 320
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 160
        && data.role in ['admin', 'guest']
        && isValidId(data.adminUid)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ClinicCase payload
    function isValidCasePayload(payload) {
      return payload is map
        && payload.keys().hasAll([
          'gender', 'address', 'ethnicity', 'occupation', 'comorbidities',
          'admissionReasons', 'treatmentBeforeAdmission', 'nasalSymptoms',
          'eyeSymptoms', 'neurologicalSymptoms', 'vitalSigns', 'labResults',
          'diseaseExtent', 'lundMackay', 'nasalPolypScoreR', 'nasalPolypScoreL',
          'treatmentFeatures'
        ])
        && payload.keys().hasOnly([
          'age', 'gender', 'address', 'provinceDetails', 'ethnicity', 'occupation',
          'comorbidities', 'admissionReasons', 'symptomDurationDays',
          'treatmentBeforeAdmission', 'priorTreatmentDetails', 'nasalSymptoms',
          'eyeSymptoms', 'neurologicalSymptoms', 'vitalSigns', 'labResults',
          'diseaseExtent', 'lundMackay', 'nasalPolypScoreR', 'nasalPolypScoreL',
          'snot22Score', 'treatmentFeatures', 'auditStatus'
        ])
        && isOptionalNumber(payload, 'age')
        && payload.gender is string && payload.gender.size() <= 20
        && payload.address is string && payload.address.size() <= 40
        && isOptionalString(payload, 'provinceDetails', 160)
        && payload.ethnicity is string && payload.ethnicity.size() <= 60
        && payload.occupation is string && payload.occupation.size() <= 80
        && payload.comorbidities is map
        && payload.admissionReasons is list && payload.admissionReasons.size() <= 20
        && (payload.admissionReasons.size() == 0 || payload.admissionReasons[0] is string)
        && isOptionalNumber(payload, 'symptomDurationDays')
        && payload.treatmentBeforeAdmission is string && payload.treatmentBeforeAdmission.size() <= 60
        && isOptionalString(payload, 'priorTreatmentDetails', 1000)
        && payload.nasalSymptoms is map
        && payload.eyeSymptoms is map
        && payload.neurologicalSymptoms is map
        && payload.vitalSigns is map
        && payload.labResults is map
        && payload.diseaseExtent is map
        && payload.lundMackay is map
        && payload.nasalPolypScoreR is number && payload.nasalPolypScoreR >= 0 && payload.nasalPolypScoreR <= 4
        && payload.nasalPolypScoreL is number && payload.nasalPolypScoreL >= 0 && payload.nasalPolypScoreL <= 4
        && isOptionalNumber(payload, 'snot22Score')
        && payload.treatmentFeatures is map
        && (!('auditStatus' in payload) || payload.auditStatus == null || payload.auditStatus is map);
    }

    // Validation Blueprint: ClinicCase
    function isValidClinicCase(data, caseId) {
      return data.keys().hasAll([
          'id', 'adminUid', 'ownerId', 'lastEditedBy', 'authorizedUids',
          'isTrashed', 'trashedAt', 'trashedBy', 'deleted',
          'caseCode', 'surgeryDate', 'primaryDiagnosis', 'surgeryType',
          'complexityGrade', 'totalLundMackayScore', 'clientCreatedAt',
          'clientUpdatedAt', 'createdAt', 'updatedAt', 'casePayload'
        ])
        && data.keys().hasOnly([
          'id', 'adminUid', 'ownerId', 'lastEditedBy', 'authorizedUids',
          'isTrashed', 'trashedAt', 'trashedBy', 'deleted',
          'caseCode', 'surgeryDate', 'primaryDiagnosis', 'surgeryType',
          'complexityGrade', 'totalLundMackayScore', 'clientCreatedAt',
          'clientUpdatedAt', 'createdAt', 'updatedAt', 'casePayload'
        ])
        && isValidId(data.id)
        && data.id == caseId
        && isValidId(data.adminUid)
        && isValidId(data.ownerId)
        && data.lastEditedBy is string && data.lastEditedBy.size() <= 160
        && isValidAuthorizedUids(data)
        && data.isTrashed is bool
        && isOptionalNumber(data, 'trashedAt')
        && isOptionalString(data, 'trashedBy', 160)
        && data.deleted is bool
        && data.caseCode is string && data.caseCode.size() >= 1 && data.caseCode.size() <= 64
        && data.surgeryDate is string && data.surgeryDate.size() <= 20 && data.surgeryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.primaryDiagnosis is string && data.primaryDiagnosis.size() <= 500
        && data.surgeryType is string && data.surgeryType.size() <= 300
        && data.complexityGrade is string && data.complexityGrade.size() <= 120
        && data.totalLundMackayScore is number && data.totalLundMackayScore >= 0 && data.totalLundMackayScore <= 24
        && data.clientCreatedAt is number
        && data.clientUpdatedAt is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidCasePayload(data.casePayload);
    }

    // Validation Blueprint: ClinicCaseImage
    function isValidClinicCaseImage(data, imageId, caseId) {
      return data.keys().hasAll([
          'id', 'adminUid', 'ownerId', 'caseId', 'authorizedUids',
          'type', 'timing', 'title', 'notes', 'dataUrl', 'uploadedAt',
          'deleted', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'adminUid', 'ownerId', 'caseId', 'authorizedUids',
          'type', 'timing', 'title', 'notes', 'dataUrl', 'uploadedAt',
          'deleted', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == imageId
        && isValidId(data.adminUid)
        && isValidId(data.ownerId)
        && isValidId(data.caseId)
        && data.caseId == caseId
        && isValidAuthorizedUids(data)
        && data.type in ['CT_SCAN', 'ENDOSCOPY', 'CLINICAL_PHOTO']
        && data.timing in ['PRE_OP', 'POST_OP', 'DISCHARGE']
        && data.title is string && data.title.size() <= 200
        && data.notes is string && data.notes.size() <= 1000
        && data.dataUrl is string && data.dataUrl.size() <= 750000
        && data.uploadedAt is number
        && data.deleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Singleton Admin Bootstrap Lock (zero PII)
    match /appMeta/{docId} {
      allow get: if docId == 'bootstrap';
      allow list: if false;
      allow create: if docId == 'bootstrap'
        && isSignedIn()
        && !exists(/databases/$(database)/documents/appMeta/bootstrap)
        && isValidBootstrap(incoming())
        && incoming().adminUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update, delete: if false;
    }

    // Authoritative Admin Markers
    match /admins/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidAdminMarker(incoming(), userId)
        && !exists(/databases/$(database)/documents/admins/$(userId))
        && getAfter(/databases/$(database)/documents/appMeta/bootstrap).data.adminUid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update, delete: if false;
    }

    // Self-Created Accounts (Admin + Admin-created Guests)
    match /accounts/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && (request.auth.uid == userId || existing().adminUid == request.auth.uid);
      allow list: if isSignedIn() && resource.data.adminUid == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidAppAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          // First-run atomic Admin bootstrap
          (
            request.auth.uid == userId
            && incoming().role == 'admin'
            && incoming().adminUid == userId
            && incoming().active == true
            && existsAfter(/databases/$(database)/documents/admins/$(userId))
            && getAfter(/databases/$(database)/documents/appMeta/bootstrap).data.adminUid == userId
          ) ||
          // Admin creating a Guest account
          (
            isAdmin()
            && incoming().role == 'guest'
            && incoming().adminUid == request.auth.uid
          )
        );
      allow update: if isAdmin()
        && isValidId(userId)
        && existing().adminUid == request.auth.uid
        && isValidAppAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().adminUid == existing().adminUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'active', 'updatedAt']);
      allow delete: if isAdmin()
        && isValidId(userId)
        && existing().adminUid == request.auth.uid
        && existing().role == 'guest';
    }

    // Shared Clinic Cases (Active + Admin Trash)
    match /clinicCases/{caseId} {
      allow get: if isSignedIn()
        && isValidId(caseId)
        && (
          (isAdmin() && existing().adminUid == request.auth.uid) ||
          (isActiveAccount()
            && request.auth.uid in existing().authorizedUids
            && existing().isTrashed == false
            && existing().deleted == false)
        );
      allow list: if isSignedIn()
        && (
          resource.data.adminUid == request.auth.uid ||
          (
            request.auth.uid in resource.data.authorizedUids
            && resource.data.isTrashed == false
            && resource.data.deleted == false
          )
        );
      allow create: if isSignedIn()
        && isActiveAccount()
        && isValidId(caseId)
        && isValidClinicCase(incoming(), caseId)
        && incoming().ownerId == request.auth.uid
        && incoming().adminUid == accountData().adminUid
        && request.auth.uid in incoming().authorizedUids
        && incoming().deleted == false
        && incoming().isTrashed == false
        && incoming().trashedAt == null
        && incoming().trashedBy == null
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isActiveAccount()
        && isValidId(caseId)
        && isValidClinicCase(incoming(), caseId)
        && incoming().id == existing().id
        && incoming().adminUid == existing().adminUid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().clientCreatedAt == existing().clientCreatedAt
        && incoming().updatedAt == request.time
        && (
          // Admin: full edit, trash, restore, permanent tombstone, or permission sync
          (
            isAdmin()
            && existing().adminUid == request.auth.uid
            && (
              (incoming().deleted == false && incoming().diff(existing()).affectedKeys().hasOnly([
                'lastEditedBy', 'authorizedUids', 'isTrashed', 'trashedAt', 'trashedBy',
                'caseCode', 'surgeryDate', 'primaryDiagnosis', 'surgeryType',
                'complexityGrade', 'totalLundMackayScore', 'clientUpdatedAt',
                'deleted', 'updatedAt', 'casePayload'
              ])) ||
              (incoming().deleted == true && incoming().diff(existing()).affectedKeys().hasOnly([
                'lastEditedBy', 'isTrashed', 'trashedAt', 'trashedBy', 'deleted', 'clientUpdatedAt', 'updatedAt'
              ])) ||
              (incoming().diff(existing()).affectedKeys().hasOnly([
                'authorizedUids', 'updatedAt'
              ]))
            )
          ) ||
          // Guest: edit active case OR move active case to Admin Trash (cannot restore or permanently delete)
          (
            !isAdmin()
            && existing().adminUid == accountData().adminUid
            && request.auth.uid in existing().authorizedUids
            && existing().isTrashed == false
            && existing().deleted == false
            && incoming().deleted == false
            && incoming().authorizedUids == existing().authorizedUids
            && (
              (
                incoming().isTrashed == false
                && incoming().trashedAt == null
                && incoming().trashedBy == null
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'lastEditedBy', 'caseCode', 'surgeryDate', 'primaryDiagnosis',
                  'surgeryType', 'complexityGrade', 'totalLundMackayScore',
                  'clientUpdatedAt', 'updatedAt', 'casePayload'
                ])
              ) ||
              (
                incoming().isTrashed == true
                && incoming().trashedAt is number
                && incoming().trashedBy is string
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'lastEditedBy', 'isTrashed', 'trashedAt', 'trashedBy', 'clientUpdatedAt', 'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(caseId) && existing().adminUid == request.auth.uid;

      // Clinical Images Subcollection
      match /images/{imageId} {
        allow get: if isSignedIn()
          && isValidId(caseId)
          && isValidId(imageId)
          && (
            (isAdmin() && existing().adminUid == request.auth.uid) ||
            (isActiveAccount() && request.auth.uid in existing().authorizedUids)
          );
        allow list: if isSignedIn()
          && (
            resource.data.adminUid == request.auth.uid ||
            request.auth.uid in resource.data.authorizedUids
          );
        allow create: if isSignedIn()
          && isActiveAccount()
          && isValidId(caseId)
          && isValidId(imageId)
          && isValidClinicCaseImage(incoming(), imageId, caseId)
          && incoming().ownerId == request.auth.uid
          && incoming().adminUid == accountData().adminUid
          && request.auth.uid in incoming().authorizedUids
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/clinicCases/$(caseId))
          && get(/databases/$(database)/documents/clinicCases/$(caseId)).data.adminUid == incoming().adminUid
          && get(/databases/$(database)/documents/clinicCases/$(caseId)).data.isTrashed == false
          && get(/databases/$(database)/documents/clinicCases/$(caseId)).data.deleted == false
          && (
            isAdmin() ||
            request.auth.uid in get(/databases/$(database)/documents/clinicCases/$(caseId)).data.authorizedUids
          );
        allow update: if isSignedIn()
          && isActiveAccount()
          && isValidId(caseId)
          && isValidId(imageId)
          && isValidClinicCaseImage(incoming(), imageId, caseId)
          && incoming().id == existing().id
          && incoming().adminUid == existing().adminUid
          && incoming().ownerId == existing().ownerId
          && incoming().caseId == existing().caseId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/clinicCases/$(caseId))
          && (
            (
              isAdmin()
              && existing().adminUid == request.auth.uid
              && (
                (incoming().deleted == false && incoming().diff(existing()).affectedKeys().hasOnly([
                  'authorizedUids', 'type', 'timing', 'title', 'notes', 'dataUrl', 'uploadedAt', 'deleted', 'updatedAt'
                ])) ||
                (incoming().deleted == true && incoming().diff(existing()).affectedKeys().hasOnly([
                  'deleted', 'dataUrl', 'updatedAt'
                ])) ||
                (incoming().diff(existing()).affectedKeys().hasOnly([
                  'authorizedUids', 'updatedAt'
                ]))
              )
            ) ||
            (
              !isAdmin()
              && existing().adminUid == accountData().adminUid
              && request.auth.uid in existing().authorizedUids
              && get(/databases/$(database)/documents/clinicCases/$(caseId)).data.isTrashed == false
              && get(/databases/$(database)/documents/clinicCases/$(caseId)).data.deleted == false
              && incoming().authorizedUids == existing().authorizedUids
              && (
                (incoming().deleted == false && incoming().diff(existing()).affectedKeys().hasOnly([
                  'type', 'timing', 'title', 'notes', 'dataUrl', 'uploadedAt', 'deleted', 'updatedAt'
                ])) ||
                (incoming().deleted == true && incoming().diff(existing()).affectedKeys().hasOnly([
                  'deleted', 'dataUrl', 'updatedAt'
                ]))
              )
            )
          );
        allow delete: if isAdmin() && isValidId(caseId) && isValidId(imageId) && existing().adminUid == request.auth.uid;
      }
    }
  }
}
