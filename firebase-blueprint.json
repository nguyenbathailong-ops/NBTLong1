{
  "entities": {
    "AppBootstrap": {
      "title": "AppBootstrap",
      "description": "Singleton initialization lock storing only non-PII admin bootstrap status and primary admin UID.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["bootstrap"]
        },
        "initialized": {
          "type": "boolean"
        },
        "adminUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "initialized", "adminUid", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Authoritative marker document proving a UID holds Admin privileges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt", "updatedAt"]
    },
    "AppAccount": {
      "title": "AppAccount",
      "description": "Self-created Admin or Guest account profile managed by the clinic Admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["admin", "guest"]
        },
        "adminUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "email",
        "displayName",
        "role",
        "adminUid",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClinicCase": {
      "title": "ClinicCase",
      "description": "Shared clinical rhinology case record with Admin Trash & Restore lifecycle.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "adminUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "lastEditedBy": {
          "type": "string",
          "maxLength": 160
        },
        "authorizedUids": {
          "type": "array",
          "description": "Bounded list (max 50) containing adminUid and active guest UIDs."
        },
        "isTrashed": {
          "type": "boolean"
        },
        "trashedAt": {
          "type": ["number", "null"]
        },
        "trashedBy": {
          "type": ["string", "null"],
          "maxLength": 160
        },
        "deleted": {
          "type": "boolean"
        },
        "caseCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "surgeryDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "primaryDiagnosis": {
          "type": "string",
          "maxLength": 500
        },
        "surgeryType": {
          "type": "string",
          "maxLength": 300
        },
        "complexityGrade": {
          "type": "string",
          "maxLength": 120
        },
        "totalLundMackayScore": {
          "type": "number"
        },
        "clientCreatedAt": {
          "type": "number"
        },
        "clientUpdatedAt": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "casePayload": {
          "type": "object",
          "description": "Structured clinical variables covering epidemiology (including optional internal patientName), symptoms, vitals, labs, Lund-Mackay, and treatment."
        }
      },
      "required": [
        "id",
        "adminUid",
        "ownerId",
        "lastEditedBy",
        "authorizedUids",
        "isTrashed",
        "trashedAt",
        "trashedBy",
        "deleted",
        "caseCode",
        "surgeryDate",
        "primaryDiagnosis",
        "surgeryType",
        "complexityGrade",
        "totalLundMackayScore",
        "clientCreatedAt",
        "clientUpdatedAt",
        "createdAt",
        "updatedAt",
        "casePayload"
      ]
    },
    "ClinicCaseImage": {
      "title": "ClinicCaseImage",
      "description": "Compressed CT Scan, Endoscopy, or Clinical Photo document belonging to a ClinicCase (Pre-op or Discharge).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "adminUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "caseId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedUids": {
          "type": "array",
          "description": "Bounded list (max 50) containing adminUid and active guest UIDs."
        },
        "type": {
          "type": "string",
          "enum": ["CT_SCAN", "ENDOSCOPY", "CLINICAL_PHOTO"]
        },
        "timing": {
          "type": "string",
          "enum": ["PRE_OP", "POST_OP", "DISCHARGE"]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "dataUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "uploadedAt": {
          "type": "number"
        },
        "deleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "adminUid",
        "ownerId",
        "caseId",
        "authorizedUids",
        "type",
        "timing",
        "title",
        "notes",
        "dataUrl",
        "uploadedAt",
        "deleted",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/appMeta/bootstrap": {
      "schema": { "$ref": "#/entities/AppBootstrap" },
      "description": "Singleton lock indicating whether the initial Admin account has been claimed."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted database record verifying Admin privileges for the specified UID."
    },
    "/accounts/{userId}": {
      "schema": { "$ref": "#/entities/AppAccount" },
      "description": "Self-created Admin and Guest accounts with active/disabled flag and role."
    },
    "/clinicCases/{caseId}": {
      "schema": { "$ref": "#/entities/ClinicCase" },
      "description": "Shared clinic cases accessible to Admin (active + trash) and active Guests (active only)."
    },
    "/clinicCases/{caseId}/images/{imageId}": {
      "schema": { "$ref": "#/entities/ClinicCaseImage" },
      "description": "Clinical CT scan and endoscopy images scoped under each ClinicCase."
    }
  }
}
